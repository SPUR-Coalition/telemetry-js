{
  "name": "@openattribution/telemetry",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript SDK for the Content Telemetry standard, maintained by SPUR",
  "license": "Apache-2.0",
  "author": "OpenAttribution Project",
  "homepage": "https://github.com/SPUR-Coalition/telemetry-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPUR-Coalition/telemetry-js"
  },
  "keywords": [
    "openattribution",
    "telemetry",
    "ai-agents",
    "mcp",
    "content-attribution",
    "acp",
    "ucp"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:wire": "python3 scripts/check-wire.py"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
